---
import { profile } from "../data/profile";
---

<section id="top" class="hero">
  <div class="container hero__inner">
    <p class="eyebrow hero__role">{profile.role}</p>
    <h1>{profile.name}</h1>
    <p class="hero__introduction">{profile.introduction}</p>
    <div class="hero__actions">
      <a class="action action--primary" href="#projects">Ver proyectos</a>
      <a class="action action--secondary" href="#contact">Contactar</a>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    min-height: min(48rem, calc(100svh - 7rem));
    align-items: center;
    padding-block: clamp(var(--space-16), 13vw, 10rem);
  }

  .hero__inner {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-6);
  }

  .hero__role {
    color: var(--color-accent);
  }

  h1 {
    max-width: 12ch;
    font-size: var(--text-display);
    font-weight: 560;
    letter-spacing: -0.075em;
    line-height: 0.98;
    overflow-wrap: anywhere;
  }

  .hero__introduction {
    max-width: 38rem;
    color: var(--color-muted);
    font-size: var(--text-lead);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-block-start: var(--space-2);
  }

  .action {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-control);
    font-size: var(--text-small);
    font-weight: 650;
    text-decoration: none;
    transition: var(--transition-colors);
  }

  .action--primary {
    color: var(--color-accent-contrast);
    background: var(--color-accent);
  }

  .action--secondary {
    color: var(--color-accent);
    background: transparent;
  }

  .action:hover {
    border-color: var(--color-foreground);
  }

  @media (min-width: 48rem) {
    .hero__inner {
      gap: var(--space-8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .action {
      transition: none;
    }
  }
</style>
