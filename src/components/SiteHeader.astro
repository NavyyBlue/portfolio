---
import ThemeToggle from "./ThemeToggle.astro";

const homePrefix = Astro.url.pathname === "/" ? "" : "/";
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={`${homePrefix}#top`}>Jean Carlo Cárdenas</a>

    <nav class="site-nav" aria-label="Navegación principal">
      <a href={`${homePrefix}#about`}>About</a>
      <a href={`${homePrefix}#experience`}>Experience</a>
      <a href={`${homePrefix}#projects`}>Projects</a>
      <a href={`${homePrefix}#contact`}>Contact</a>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 10;
    inset-block-start: 0;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-page);
    transition: var(--transition-colors);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
    padding-block: var(--space-3);
  }

  .site-header__brand {
    color: var(--color-foreground);
    font-size: var(--text-small);
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav {
    display: flex;
    flex: 1 0 100%;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    order: 1;
  }

  .site-nav a {
    padding-block: var(--space-2);
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 550;
    text-decoration: none;
    transition: color var(--motion-fast) var(--motion-ease);
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--color-accent);
  }

  @media (min-width: 58rem) {
    .site-header__inner {
      flex-wrap: nowrap;
      gap: var(--space-8);
    }

    .site-nav {
      flex: 0 1 auto;
      justify-content: flex-end;
      gap: var(--space-8);
      order: 0;
      margin-inline-start: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-nav a {
      transition: none;
    }
  }
</style>
