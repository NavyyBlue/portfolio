---
import type { ExperienceEntry } from "../data/experience";

interface Props {
  entries: readonly ExperienceEntry[];
}

const { entries } = Astro.props;
---

{entries.length > 0 ? (
  <ol class="timeline">
    {entries.map((entry) => (
      <li class="timeline__item">
        <p class="timeline__period">{entry.period}</p>
        <div class="timeline__content">
          <h3>{entry.role}</h3>
          <p class="timeline__company">{entry.company}</p>
          <p class="timeline__description">{entry.description}</p>
        </div>
      </li>
    ))}
  </ol>
) : (
  <p class="section__placeholder">La experiencia profesional está pendiente de contenido confirmado.</p>
)}

<style>
  .timeline {
    display: grid;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding-inline-start: var(--space-6);
    border-inline-start: 1px solid var(--color-border);
  }

  .timeline__item::before {
    position: absolute;
    inset-block-start: 0.4rem;
    inset-inline-start: -0.3rem;
    width: 0.55rem;
    aspect-ratio: 1;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-page);
    content: "";
  }

  .timeline__period,
  .timeline__company {
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .timeline__content h3 {
    margin-block-end: var(--space-2);
    font-size: 1.25rem;
  }

  .timeline__company {
    margin-block-end: var(--space-3);
  }

  .timeline__description {
    max-width: var(--reading-width);
  }

  @media (min-width: 48rem) {
    .timeline__item {
      grid-template-columns: minmax(8rem, 0.45fr) minmax(0, 1fr);
      gap: var(--space-8);
      padding-inline-start: var(--space-8);
    }
  }
</style>
